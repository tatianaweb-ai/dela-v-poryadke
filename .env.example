# Два значения из окна Connect → Next.js на странице Data API в Supabase.
# Publishable key (sb_publishable_…) предназначен для браузера и не является
# секретом. Service role key (sb_secret_…) приложению не нужен — доступ
# ограничивают правила доступа в базе, а не секретный ключ.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
